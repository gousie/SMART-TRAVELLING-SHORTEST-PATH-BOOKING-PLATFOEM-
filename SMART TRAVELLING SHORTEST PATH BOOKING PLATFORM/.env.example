# Development only: database CTPDB and password root as requested.
# Create CTPDB in PostgreSQL first. Never use root as a production password.
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/CTPDB
POSTGRES_PASSWORD=root
# Replace this with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STORAGE_SECRET=replace-with-a-long-random-secret-before-running
PORT=8080
SEED_DEMO=true
# Disable autosignin for normal authentication. Demo buttons are public sample accounts.
DEMO_AUTOSIGNIN=false
# To explicitly choose the single-process SQLite demo instead:
# DATABASE_URL=sqlite:///./railora-demo.db
# Isolated test database only (never use CTPDB here):
# TEST_DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/CTPDB_test
